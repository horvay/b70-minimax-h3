+        auto q_in = ggml_cast(ctx, ggml_reshape_3d(ctx, ggml_ext_cont(ctx, q), d_head, L_q, n_head), GGML_TYPE_F16);
+        auto k_in = ggml_reshape_3d(ctx, ggml_ext_cont(ctx, k), d_head, L_k, n_kv_head);
